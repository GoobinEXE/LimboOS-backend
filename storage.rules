rules_version = '2';

// Storage multi-tenant (Fase 1). Arquivos novos ficam sob workspaces/{ws}/...;
// os caminhos antigos (media/, audios/, mediaAssets/, achievementIcons/, npcAvatars/)
// ficam somente leitura para a conta com o claim admin legado até a migração ser
// validada. URLs de download com token continuam funcionando para os jogadores.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isActive() {
      return signedIn() && !(
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('suspended', false) == true
      );
    }

    function isOwner(ws) {
      return isActive() && request.auth.uid == ws;
    }

    function memberPath(ws) {
      return /databases/(default)/documents/workspaces/$(ws)/members/$(request.auth.uid);
    }

    function isMember(ws) {
      return isActive() && firestore.exists(memberPath(ws));
    }

    function memberHasCampaign(ws, c) {
      return isMember(ws) && c in firestore.get(memberPath(ws)).data.get('campaignIds', []);
    }

    function isPlayer(ws) {
      return isActive()
        && firestore.exists(/databases/(default)/documents/workspaces/$(ws)/players/$(request.auth.uid));
    }

    function isLegacyAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isImageUpload() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isAllowedMediaUpload() {
      return request.resource.size < 100 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('text/.*')
        );
    }

    // Foto de perfil do agente: só o próprio jogador grava.
    match /profilePhotos/{userId}/{allPaths=**} {
      allow read: if isActive() && request.auth.uid == userId;
      allow write: if isActive()
        && request.auth.uid == userId
        && isImageUpload();
    }

    // Mídia da biblioteca da pasta (sem campanha): só o dono.
    match /workspaces/{ws}/media/{allPaths=**} {
      allow read: if isOwner(ws);
      allow write: if isOwner(ws) && (request.resource == null || isAllowedMediaUpload());
    }

    // Mídia de uma campanha: dono e co-mestres daquela campanha.
    match /workspaces/{ws}/campaigns/{c}/media/{allPaths=**} {
      allow read: if isOwner(ws) || memberHasCampaign(ws, c);
      allow write: if (isOwner(ws) || memberHasCampaign(ws, c))
        && (request.resource == null || isAllowedMediaUpload());
    }

    // Ícones de conquista e avatares de NPC aparecem para os jogadores da pasta.
    match /workspaces/{ws}/achievementIcons/{allPaths=**} {
      allow read: if isOwner(ws) || isMember(ws) || isPlayer(ws);
      allow write: if (isOwner(ws) || isMember(ws))
        && (request.resource == null || isImageUpload());
    }

    match /workspaces/{ws}/npcAvatars/{allPaths=**} {
      allow read: if isOwner(ws) || isMember(ws) || isPlayer(ws);
      allow write: if (isOwner(ws) || isMember(ws))
        && (request.resource == null || isImageUpload());
    }

    // Legado: leitura para conferência, sem escrita.
    match /{legacyRoot}/{allPaths=**} {
      allow read: if isLegacyAdmin()
        && legacyRoot in ['media', 'audios', 'mediaAssets', 'achievementIcons', 'npcAvatars'];
    }
  }
}
