
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function isValidPayloadSize() {
      return request.resource.data.keys().size() < 50; 
    }

    // Regras de Campanhas - Crítico para a tela de seleção
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /qrRedirects/{redirectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /{path=**}/characters/{characterId} {
      allow read: if isAdmin();
    }
    match /{path=**}/achievements/{achId} {
      allow read: if isAdmin();
    }
    match /{path=**}/stats/{statDoc} {
      allow read: if isAdmin();
    }
    match /system/gameEvents {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /system/limboState {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readThreadIds']);
      allow write: if isAdmin();
    }
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && request.resource.data.role != 'admin');
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'spotifyPlaylistUrl', 'forceTerminalOpen', 'forceMacOpen', 'campaignId', 'masterName', 'displayName', 'codinome', 'agentStatus', 'dangerLevel', 'profilePhotoUrl', 'agentId', 'intelMigrated', 'intelMigratedAt']));
      allow delete: if isAdmin();

      // --- Multi-Character Model (current) ---
      match /characters/{characterId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();

        match /tapes/{tapeId} {
          allow read: if isOwner(userId) || isAdmin();
          allow write: if isOwner(userId) || isAdmin();
        }
        match /intel/{intelId} {
          allow read: if isOwner(userId) || isAdmin();
          allow write: if isOwner(userId) || isAdmin();
        }
        match /achievements/{achId} {
          allow read: if isOwner(userId) || isAdmin();
          allow write: if isOwner(userId) || isAdmin();
        }
        match /stats/{statDoc} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update: if (isOwner(userId) && isValidPayloadSize()) || isAdmin();
          allow delete: if isOwner(userId) || isAdmin();
        }
        match /gallery/{imageId} {
          allow read: if isOwner(userId) || isAdmin();
          allow write: if isOwner(userId) || isAdmin();
        }
      }

      // --- Legacy direct subcollections (backward compat) ---
      match /tapes/{tapeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
      match /achievements/{achId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
      match /stats/{statDoc} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) && isValidPayloadSize()) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
      match /gallery/{imageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }
    match /audios/{audioId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /intel_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /gallery/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }
    match /jukeboxTracks/{trackId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /mediaAssets/{assetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /playEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isOwner(request.resource.data.uid) && isValidPayloadSize();
      allow update: if isOwner(resource.data.uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
